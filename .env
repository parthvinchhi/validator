# The app reads REAL environment variables. It does not load this file
# automatically (that would need an extra dependency). Use this file as a
# reference and set the variables in your shell, systemd, Docker, etc.

PORT=8080
ENVIRONMENT=development

# Optional. If set, every /api/ request must send header: X-API-Key: <value>
API_KEY=

# Optional. Comma-separated browser origins allowed by CORS.
# Empty = no CORS headers (fine for server-to-server calls).
CORS_ALLOWED_ORIGINS=

# Max requests per minute per client IP. 0 disables rate limiting.
RATE_LIMIT_PER_MINUTE=300

# Optional. Comma-separated IPs of reverse proxies you trust to set
# X-Forwarded-For. Empty = trust nobody (use the direct connection IP).
TRUSTED_PROXIES=